APP_NAME="Apotek POS Local"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8001

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=apotek_local
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="pos@apotek.local"
MAIL_FROM_NAME="${APP_NAME}"

# POS Identity
BRANCH_ID=BR01
TERMINAL_ID=POS01

# Cloud Sync Settings (Default disabled)
CLOUD_SYNC_ENABLED=false
CLOUD_HUB_URL=http://127.0.0.1:8000
CLOUD_HUB_TOKEN=

# Hardware Bridge (FastAPI Python Service)
HARDWARE_BRIDGE_URL=http://127.0.0.1:8765
HARDWARE_BRIDGE_TOKEN=bridge-secret-token
HARDWARE_MOCK_MODE=true

# Database Management (DBM) Paths (Windows/Laragon)
MYSQL_DUMP_PATH='C:\laragon\bin\mysql\mysql-8.4.3-winx64\bin\mysqldump.exe'
MYSQL_PATH='C:\laragon\bin\mysql\mysql-8.4.3-winx64\bin\mysql.exe'
BACKUP_LOCAL_PATH="storage/app/backups"

# Licensing (Offline Ed25519)
# PERINGATAN: DILARANG KERAS MENYIMPAN LICENSE_PRIVATE_KEY DI LOKAL!
LICENSE_PUBLIC_KEY=
LICENSE_HWID_MOCK=

VITE_APP_NAME="${APP_NAME}"
